@page
@model SkinCareService.Pages.SkinServiceUpdateModel
@{
}
@{
    ViewData["Title"] = "Update Service";
}

<div class="container mt-5">
    <h2 class="text-center mb-4">Update Service</h2>

    <form method="post">
        <input type="hidden" name="ServiceId" value="@Model.Service.ServiceId" />
        <input type="hidden" name="Status" value="@Model.Service.Status" />

        <div class="form-group mb-3">
            <label for="serviceName">Service Name</label>
            <input type="text" id="serviceName" name="ServiceName" class="form-control" value="@Model.Service.ServiceName" required />
        </div>

        <div class="form-group mb-3">
            <label for="description">Description</label>
            <textarea id="description" name="Description" class="form-control" rows="4">@Model.Service.Description</textarea>
        </div>

        <div class="form-group mb-3">
            <label for="price">Price</label>
            <input type="number" id="price" name="Price" class="form-control" value="@Model.Service.Price" required />
        </div>

        <div class="form-group mb-3">
            <label for="duration">Duration (Minutes)</label>
            <input type="number" id="duration" name="Duration" class="form-control" value="@Model.Service.Duration" required />
        </div>

        <button type="submit" class="btn btn-primary w-100">Update Service</button>
    </form>
</div>
