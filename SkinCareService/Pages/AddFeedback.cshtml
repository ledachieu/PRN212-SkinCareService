@page
@model AddFeedbackModel

<h2>Add Feedback for Booking #@Model.BookingId</h2>

@if (Model.ErrorMessage != null)
{
    <div class="alert alert-danger">@Model.ErrorMessage</div>
}

@if (Model.SuccessMessage != null)
{
    <div class="alert alert-success">@Model.SuccessMessage</div>
}

<form method="post">
    <input type="hidden" asp-for="BookingId" />

    <div class="mb-3">
        <label class="form-label">Rating (1-5)</label>
        <input type="number" asp-for="Rating" class="form-control" min="1" max="5" required />
    </div>

    <div class="mb-3">
        <label class="form-label">Comments</label>
        <textarea asp-for="Comments" class="form-control" required></textarea>
    </div>

    <button type="submit" class="btn btn-success">Submit</button>
    <a asp-page="/MyBooking" class="btn btn-secondary">Back to Bookings</a>
</form>