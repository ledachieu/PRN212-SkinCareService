@page
@model SkinCareService.Pages.SkinCareListModel
@{
    ViewData["Title"] = "Dịch Vụ Chăm Sóc Da";
}

<div class="container mt-5">
    <h2 class="text-center mb-4">Danh Sách Dịch Vụ Chăm Sóc Da</h2>

    <div class="row">
        @foreach (var service in Model.Services)
        {
            <div class="col-md-4 mb-4">
                <div class="card shadow-sm">
                    <img src="https://www.gainesvilledermatologyaestheticcenter.com/content/uploads/posts/32/skincare-services-hero.jpg" class="card-img-top" alt="Dịch vụ @service.ServiceName">
                    <div class="card-body">
                        <h5 class="card-title">@service.ServiceName</h5>
                        <p class="fw-bold text-danger">Giá: @service.Price.ToString("N0") VNĐ</p>
                        <p class="fw-bold">⏳ Thời gian: @service.Duration phút</p>
                        <a href="/SkinCareDetail?id=@service.ServiceId" class="btn btn-primary w-100">Chi Tiết</a>
                        <a href="/BookSkinService/@service.ServiceId" class="btn btn-success mt-2 w-100">Đặt Dịch Vụ</a>
                    </div>
                </div>
            </div>
        }
    </div>

    <!-- Phân trang -->
    <nav aria-label="Page navigation">
        <ul class="pagination justify-content-center mt-4">
            @if (Model.CurrentPage > 1)
            {
                <li class="page-item">
                    <a class="page-link" href="?page=@(Model.CurrentPage - 1)" aria-label="Previous">
                        <span aria-hidden="true">&laquo; Trước</span>
                    </a>
                </li>
            }

            @for (int i = 1; i <= Model.TotalPages; i++)
            {
                <li class="page-item @(i == Model.CurrentPage ? "active" : "")">
                    <a class="page-link" href="?page=@i">@i</a>
                </li>
            }

            @if (Model.CurrentPage < Model.TotalPages)
            {
                <li class="page-item">
                    <a class="page-link" href="?page=@(Model.CurrentPage + 1)" aria-label="Next">
                        <span aria-hidden="true">Tiếp &raquo;</span>
                    </a>
                </li>
            }
        </ul>
    </nav>
</div>

<!-- Bootstrap 5 -->
<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
