@page
@model SkinCareService.Pages.DashboardModel
@{
}
<div class="container mt-4">
    <h2 class="text-center mb-4">Admin Dashboard</h2>

    <div class="row">
        <!-- Total Customers -->
        <div class="col-md-3">
            <div class="card text-white bg-primary shadow-lg">
                <div class="card-body">
                    <h5 class="card-title">Total Customers</h5>
                    <h3 class="fw-bold">@Model.TotalCustomers</h3>
                </div>
            </div>
        </div>

        <!-- Completed Bookings -->
        <div class="col-md-3">
            <div class="card text-white bg-success shadow-lg">
                <div class="card-body">
                    <h5 class="card-title">Completed Bookings</h5>
                    <h3 class="fw-bold">@Model.CompletedBookings</h3>
                </div>
            </div>
        </div>

        <!-- Total Skin Services -->
        <div class="col-md-3">
            <div class="card text-white bg-info shadow-lg">
                <div class="card-body">
                    <h5 class="card-title">Total Skin Services</h5>
                    <h3 class="fw-bold">@Model.TotalSkinServices</h3>
                </div>
            </div>
        </div>

        <!-- Total Feedbacks -->
        <div class="col-md-3">
            <div class="card text-white bg-warning shadow-lg">
                <div class="card-body">
                    <h5 class="card-title">Total Feedbacks</h5>
                    <h3 class="fw-bold">@Model.TotalFeedbacks</h3>
                </div>
            </div>
        </div>
    </div>

    <!-- Recent Bookings Table -->
    <div class="mt-4">
        <h4 class="mb-3">Recent Bookings</h4>
        <table class="table table-striped table-hover shadow-lg">
            <thead class="table-dark">
                <tr>
                    <th>Booking ID</th>
                    <th>Customer</th>
                    <th>Service</th>
                    <th>Status</th>
                    <th>Booking Date</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var booking in Model.RecentBookings)
                {
                    <tr>
                        <td>@booking.BookingId</td>
                        <td>@booking.Customer?.FullName</td>
                        <td>@booking.Service?.ServiceName</td>
                        <td>
                            <span class="badge @(booking.Status == "Completed" ? "bg-success" : "bg-secondary")">
                                @booking.Status
                            </span>
                        </td>
                        <td>@booking.BookingDate.ToString("yyyy-MM-dd")</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
