@page
@model SkinCareService.Pages.MyBookingModel
@{
}
<h2 class="mb-4">Lịch sử đặt dịch vụ của bạn</h2>

<table class="table table-bordered">
    <thead class="table-dark">
        <tr>
            <th>Booking ID</th>
            <th>Tên Dịch Vụ</th>
            <th>Chuyên Viên</th>
            <th>Ngày Đặt</th>
            <th>Ngày Sử Dụng</th>
            <th>Bắt Đầu</th>
            <th>Kết Thúc</th>
            <th>Trạng Thái Thanh Toán</th>
            <th>Trạng Thái Đặt</th>
            <th>Hành Động</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var b in Model.Bookings)
        {
            <tr>
                <td>@b.BookingId</td>
                <td>@b.ServiceName</td>
                <td>@b.TherapistName</td>
                <td>@b.BookingDate.ToString("dd/MM/yyyy")</td>
                <td>@b.WorkDate.ToString("dd/MM/yyyy")</td>
                <td>@b.StartTime</td>
                <td>@b.EndTime</td>
                <td>@b.PaymentStatus</td>
                <td>@b.Status</td>

                <td>
                        @if (b.Status == "Completed")
                        {
                        <a asp-page="/AddFeedback" asp-route-bookingId="@b.BookingId" class="btn btn-primary">Add Feedback</a>
                        }
                    <a asp-page="MyBooking" asp-page-handler="Results" asp-route-bookingId="@b.BookingId" class="btn btn-info">
                        Xem Kết Quả
                    </a>
                </td>
            </tr>
        }
    </tbody>
</table>
@if (Model.ServiceResults != null && Model.SelectedBookingId != null)
{
    <h3>Kết quả dịch vụ cho Booking ID: @Model.SelectedBookingId</h3>

    @if (Model.ServiceResults.Any())
    {
        <table class="table">
            <thead>
                <tr>
                    <th>Result ID</th>
                    <th>Therapist</th>
                    <th>Description</th>
                    <th>Date</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var result in Model.ServiceResults)
                {
                    <tr>
                        <td>@result.ResultId</td>
                        <td>@result.Therapist?.User?.FullName</td>
                        <td>@result.ResultDescription</td>
                        <td>@result.ResultDate?.ToString("yyyy-MM-dd")</td>
                    </tr>
                }
            </tbody>
        </table>
    }
    else
    {
        <p class="text-danger">Không có kết quả nào cho Booking này.</p>
    }
}

